# Copy to .env.local if you need to change anything. All values are optional in development.

# Where the API lives. Leave empty in development (the Vite proxy forwards /api to localhost:5000, the backend).
# In production, if the API is on another domain:  https://api.yourdomain.com/api
# VITE_API_URL=

# Use the offline demo data instead of the server (no backend needed)
# VITE_USE_MOCK=true

# Show the "Demo pet owner / Demo pet walker" login buttons in a production build
# VITE_SHOW_DEMO=true
