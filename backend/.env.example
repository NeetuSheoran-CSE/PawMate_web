# Copy this file to .env and fill it in. Never commit .env.

PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pawmate

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call this API, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Development only: sample walkers "reply" in chat so you can see the UI working
DEMO_REPLIES=true

# Used to decide what "today" means when validating booking dates
APP_TIMEZONE=Asia/Kolkata

# Optional: enables PATCH /api/admin/walkers/:id/verification (send it as the x-admin-token header)
# ADMIN_TOKEN=another-long-random-string

# Optional: serve the built frontend (run "npm run build" in the project root first) from this server
# SERVE_CLIENT=true
# CLIENT_DIST=../frontend/dist

# Rate limits per IP address, per 15 minutes (the defaults are sensible for production)
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_MAX=30
